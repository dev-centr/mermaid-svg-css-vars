{
  "name": "@openshellorg/mermaid-svg-css-vars",
  "version": "0.1.0",
  "description": "Rewrite Mermaid-rendered SVG theme colors to CSS custom properties with fallbacks, plus web-embedding normalization.",
  "type": "module",
  "license": "MIT",
  "author": "Open Shell Organization",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openshellorg/mermaid-svg-css-vars.git"
  },
  "homepage": "https://github.com/openshellorg/mermaid-svg-css-vars#readme",
  "bugs": {
    "url": "https://github.com/openshellorg/mermaid-svg-css-vars/issues"
  },
  "keywords": [
    "mermaid",
    "svg",
    "css-variables",
    "theme",
    "dark-mode",
    "prerender",
    "mmdc"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "mermaid-svg-css-vars": "./bin/mermaid-svg-css-vars.js"
  },
  "files": [
    "dist",
    "bin",
    "README.adoc",
    "CHANGELOG.adoc",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@dev-centr/themed-svg": "github:dev-centr/themed-svg#30cc93eb85b02a1ca12c0870b5b71005bfdf059c"
  }
}
